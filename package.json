{
  "name": "dsh-superhook",
  "version": "0.2.0",
  "description": "Dependency-aware agent teamwork through official DeepSeek Harness providers",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lishize20040802-rgb/superhook.git"
  },
  "homepage": "https://github.com/lishize20040802-rgb/superhook#readme",
  "bugs": {
    "url": "https://github.com/lishize20040802-rgb/superhook/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./agent-team": {
      "types": "./lib/agent-team.d.ts",
      "import": "./lib/agent-team.js"
    },
    "./grok": {
      "types": "./lib/grok.d.ts",
      "import": "./lib/grok.js"
    },
    "./teammates": {
      "types": "./lib/teammates.d.ts",
      "import": "./lib/teammates.js"
    }
  },
  "files": [
    "lib",
    "examples",
    "docs",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:built": "node tests/built-smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run test:built",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-experimental-agent-team": "0.1.7-rc.2",
    "@deepseek-ai/dsh-jobs": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    },
    "@deepseek-ai/dsh-jobs": {
      "optional": true
    },
    "@deepseek-ai/dsh-experimental-agent-team": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subagent-acp": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@modelcontextprotocol/sdk": "1.30.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-include": "1.0.9",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.1.7-rc.2",
    "@deepseek-ai/dsh-experimental-agent-team": "0.1.7-rc.2",
    "@deepseek-ai/dsh-experimental-tool-agent-team": "0.1.7-rc.2",
    "@deepseek-ai/dsh-jobs": "0.1.7-rc.2",
    "@deepseek-ai/dsh-jobs-local": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-query": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subagent-codex": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.1.7-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tool-jobs": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "prettier": "3.9.9",
    "tsx": "^4.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
